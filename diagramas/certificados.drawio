        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Elegir tipo de certificado&#xa;Salud Pucará / SAG / Epicrisis /&#xa;Cirugía / Defunción" vertex="1">
