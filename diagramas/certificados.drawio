        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Guardar certificado&#xa;INSERT en tabla según tipo&#xa;(incluye mascota_id, propietario_id, veterinario_id)" vertex="1">
