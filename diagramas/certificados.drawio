        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Crear / asignar propietario&#xa;Tabla: propietario&#xa;Actualizar: mascota.propietario_id" vertex="1">
          <mxGeometry height="90" width="200" x="20" y="340" as="geometry" />
