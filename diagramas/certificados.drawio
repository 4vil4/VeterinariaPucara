        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Cargar formulario&#xa;Precargar: mascota, propietario,&#xa;veterinario (si rol = vet)" vertex="1">
          <mxGeometry height="90" width="250" x="220" y="560" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Completar datos específicos&#xa;(datos clínicos, textos, fechas)" vertex="1">
