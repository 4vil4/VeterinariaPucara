        <mxCell id="n15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Navegación autenticada&#xa;Cada request incluye JWT&#xa;Authorization: Bearer &lt;token&gt;&#xa;Backend verifica token y role=user&#xa;Filtra por propietario_id" vertex="1">
