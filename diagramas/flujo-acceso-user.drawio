        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Frontend guarda sesión&#xa;- auth_token (localStorage)&#xa;- auth_user (id, nombre, role)&#xa;- propietario_id asociado" vertex="1">
