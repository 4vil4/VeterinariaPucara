        <mxCell id="n1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="Inicio" vertex="1">
          <mxGeometry height="60" width="120" x="260" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Usuario abre sitio&#xa;(Home Clínica Pucará)" vertex="1">
          <mxGeometry height="70" width="240" x="210" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Click en &quot;Iniciar sesión&quot;&#xa;o &quot;Registrarse&quot;" vertex="1">
          <mxGeometry height="70" width="240" x="210" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="¿Usuario ya tiene cuenta?" vertex="1">
          <mxGeometry height="80" width="200" x="230" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Formulario registro&#xa;Crea:&#xa;- user (role = user)&#xa;- propietario vinculado" vertex="1">
          <mxGeometry height="110" width="200" x="20" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Backend registra usuario&#xa;Tabla user: email único,&#xa;password_hash&#xa;Tabla propietario: datos contacto&#xa;Enlaza propietario.user_id" vertex="1">
          <mxGeometry height="120" width="260" x="20" y="440" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Generar JWT + datos usuario&#xa;y responder al frontend&#xa;(login automático)" vertex="1">
