        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Backend valida credenciales&#xa;Tabla user&#xa;- email&#xa;- password_hash&#xa;- role = user" vertex="1">
          <mxGeometry height="110" width="240" x="420" y="410" as="geometry" />
