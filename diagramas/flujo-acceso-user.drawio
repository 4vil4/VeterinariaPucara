  <diagram id="flujo-acceso-user" name="Flujo Acceso Usuario Role USER">
    <mxGraphModel dx="703" dy="848" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
