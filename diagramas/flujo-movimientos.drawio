  <diagram id="flujo-movimientos" name="Flujo Movimientos Clínicos y Comisiones">
    <mxGraphModel dx="2852" dy="1594" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="Inicio&#xa;(usuario ya autenticado)" vertex="1">
          <mxGeometry height="70" width="140" x="170" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Panel clínico&#xa;Roles: vet / admin" vertex="1">
