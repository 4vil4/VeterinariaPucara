        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Seleccionar contexto&#xa;- Mascota&#xa;- Cita del día&#xa;- Búsqueda por historial" vertex="1">
          <mxGeometry height="90" width="240" x="120" y="230" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="¿Qué tipo de movimiento&#xa;se desea registrar?" vertex="1">
          <mxGeometry height="100" width="210" x="135" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f7ff;" value="CONSULTA GENERAL&#xa;Tabla: consulta&#xa;Campos clave:&#xa;- mascota_id&#xa;- veterinario_id&#xa;- fecha&#xa;- motivo, diagnóstico&#xa;- monto_total" vertex="1">
          <mxGeometry height="140" width="240" x="310" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n5b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Formulario Consulta&#xa;Frontend envía datos&#xa;→ API /consulta&#xa;→ INSERT en tabla consulta" vertex="1">
          <mxGeometry height="110" width="220" x="320" y="730" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f7ff;" value="VACUNACIÓN&#xa;Tabla: vacuna&#xa;Campos clave:&#xa;- mascota_id&#xa;- veterinario_id&#xa;- fecha&#xa;- vacuna, lote&#xa;- monto_total" vertex="1">
          <mxGeometry height="140" width="240" x="560" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n6b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Formulario Vacuna&#xa;→ API /vacunas&#xa;→ INSERT en tabla vacuna" vertex="1">
          <mxGeometry height="90" width="220" x="570" y="750" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" value="HOSPITALIZACIÓN&#xa;Tablas:&#xa;- hospitalizacion&#xa;- hospitalizacion_monitoreo&#xa;- hospitalizacion_observacion&#xa;Campos clave:&#xa;- mascota_id, fecha_ingreso&#xa;- veterinario_id&#xa;- medicacion_json&#xa;- monto_total" vertex="1">
          <mxGeometry height="170" width="260" x="840" y="460" as="geometry" />
        </mxCell>
        <mxCell id="n7b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Flujo:&#xa;1) Crear hospitalizacion&#xa;2) Registrar monitoreo periódico&#xa;   (hospitalizacion_monitoreo)&#xa;3) Notas diarias&#xa;   (hospitalizacion_observacion)&#xa;4) Cerrar con fecha_alta&#xa;5) Definir monto_total" vertex="1">
          <mxGeometry height="150" width="280" x="830" y="750" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9e6ff;" value="CIRUGÍA / PROCEDIMIENTOS&#xa;Tablas:&#xa;- cirugia&#xa;- profilaxis&#xa;- dermatologia&#xa;- oftalmologia" vertex="1">
          <mxGeometry height="130" width="260" x="1170" y="455" as="geometry" />
        </mxCell>
        <mxCell id="n8b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Cada procedimiento:&#xa;Formulario específico&#xa;→ API correspondiente&#xa;→ INSERT en tabla X&#xa;Siempre vinculando:&#xa;- mascota_id&#xa;- veterinario_id&#xa;- fecha&#xa;- monto_total" vertex="1">
          <mxGeometry height="140" width="260" x="1170" y="670" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ffe6;" value="TRIAJE / URGENCIA&#xa;Tabla: triaje&#xa;Campos:&#xa;- mascota_id&#xa;- fecha&#xa;- nivel, signos_vitales&#xa;- veterinario_id&#xa;- monto_total" vertex="1">
          <mxGeometry height="140" width="240" x="1530" y="450" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ffe6;" value="ORDEN DE EXAMEN&#xa;Tabla: orden_examen&#xa;Campos:&#xa;- mascota_id&#xa;- veterinario_id&#xa;- tipo_examen, laboratorio&#xa;- estado, resultados_url&#xa;- monto_total" vertex="1">
          <mxGeometry height="150" width="260" x="1510" y="650" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;" value="RECETA / ANTIBIÓTICO&#xa;Tablas:&#xa;- receta&#xa;- receta_antibiotico" vertex="1">
          <mxGeometry height="110" width="220" x="30" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n11b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Flujo:&#xa;1) Crear receta (diagnóstico,&#xa;   indicaciones, medicamentos texto)&#xa;2) Si lleva antibiótico: crear&#xa;   filas en receta_antibiotico&#xa;3) Posible envío SAG&#xa;4) Puede generar PDF receta" vertex="1">
          <mxGeometry height="150" width="260" x="10" y="800" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;" value="ANTIPARASITARIO / ANTIPULGAS&#xa;Tablas: antiparasitario, antipulgas&#xa;Campos:&#xa;- mascota_id&#xa;- producto, dosis, proxima_fecha&#xa;- veterinario_id&#xa;- monto_total" vertex="1">
          <mxGeometry height="150" width="280" x="760" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;" value="CONTROLES Y EVOLUCIÓN&#xa;Tabla: control&#xa;Campos:&#xa;- mascota_id&#xa;- fecha&#xa;- peso_kg, temperatura_c&#xa;- diagnóstico, indicaciones&#xa;- veterinario_id, monto_total" vertex="1">
          <mxGeometry height="150" width="280" x="1170" y="840" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" value="DEFUNCIÓN&#xa;Tabla: defuncion&#xa;Campos:&#xa;- mascota_id&#xa;- fecha, tipo, causa&#xa;- certificado (bool)" vertex="1">
          <mxGeometry height="130" width="230" x="1535" y="840" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;" value="Cálculo de COMISIONES&#xa;Tabla: registro_comision&#xa;Campos:&#xa;- tipo (consulta, vacuna, etc.)&#xa;- registro_id (id en tabla origen)&#xa;- veterinario_id&#xa;- base_monto, porcentaje, comision_monto&#xa;- fecha" vertex="1">
          <mxGeometry height="180" width="310" x="540" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n15b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;" value="Regla general:&#xa;Cuando se guarda un movimiento con&#xa;veterinario_id + monto_total&#xa;→ Backend calcula comisión segun tabla de configuración&#xa;→ Inserta en registro_comision&#xa;→ Disponible en v_comision_mensual_vet" vertex="1">
          <mxGeometry height="170" width="320" x="950" y="100" as="geometry" />
