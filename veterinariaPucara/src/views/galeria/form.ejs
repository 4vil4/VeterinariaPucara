<%- include('../layouts/layout', {
  title: titulo,
  stylesExtra: '<link rel="stylesheet" href="/css/galeria.css">',
  body: `
<div class="d-flex align-items-center justify-content-between mb-3">
  <h2>${titulo}</h2>
  <a class="btn btn--outline" href="/galeria/${tipo}">Volver</a>
</div>

<div class="card shadow-sm gal-form-card">
  <div class="card-body">
    <!-- IMPORTANTE: multipart/form-data -->
    <form action="${action}" method="POST" class="vstack gap-2" enctype="multipart/form-data">
      <div>
        <label class="form-label">Nombre</label>
        <input class="form-control" type="text" name="nombre" value="${item?.nombre || ''}" required>
      </div>

      <div>
        <label class="form-label">Descripción</label>
        <textarea class="form-control" name="descripcion" rows="4">${item?.descripcion || ''}</textarea>
      </div>

      <div>
        <label class="form-label">Precio (opcional)</label>
        <input class="form-control" type="number" step="0.01" name="precio" value="${item?.precio ?? ''}">
      </div>

      <div class="row">
        <div class="col">
          <label class="form-label">Subir imagen</label>
          <input class="form-control" type="file" name="imagen_file" accept="image/*">
          <div class="form-text">Sube la imagen en formato .jpg .jpeg .png</div>
        </div>
      </div>

      ${item?.imagen_url ? `
        <div class="mt-2">
          <div class="text-muted small mb-1">Vista previa actual:</div>
          <img class="gal-preview" src="${item.imagen_url}" alt="actual">
        </div>
      ` : ''}

      <div class="d-flex gap-2 mt-3">
        <button class="btn" type="submit">Guardar</button>
        <a class="btn btn--outline" href="/galeria/${tipo}">Cancelar</a>
      </div>
    </form>
  </div>
</div>
` }) %>
