<%- include('layouts/layout', { title: 'Inicio — Clínica Veterinaria Pucará',
body: `
<section class="hero gradient rounded-4 p-5 mb-4 shadow-sm">
  <div class="row align-items-center">
    <div class="col-lg-7">
      <h1 class="display-5 fw-bold text-dark mb-2">
        Clínica Veterinaria Pucará
      </h1>
      <p class="lead text-dark-70 mb-4">
        Agenda en línea, ficha clínica por paciente y generación de documentos
        en un solo lugar.
      </p>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/citas/nueva" class="btn btn-acit">Agendar cita</a>
        <a href="/propietarios" class="btn btn-apro">Ver propietarios</a>
      </div>
    </div>
    <div class="col-lg-5 d-none d-lg-block text-end">
      <div class="pet-badge-i">🐶 🐱</div>
    </div>
  </div>
</section>

<section class="mb-4">
  <div class="row g-3">
    <div class="col-md-4">
      <div class="card h-100 shadow-sm hover-card">
        <div class="card-body">
          <h5 class="card-title">Propietarios & Mascotas</h5>
          <p class="text-muted">
            Gestión de dueños, mascotas y su historial clínico.
          </p>
          <a href="/propietarios" class="btn btn-sub">Abrir módulo</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm hover-card">
        <div class="card-body">
          <h5 class="card-title">Agenda</h5>
          <p class="text-muted">
            Configura horarios, agenda y marca urgencias.
          </p>
          <a href="/citas" class="btn btn-sub">Ver agenda</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm hover-card">
        <div class="card-body">
          <h5 class="card-title">Documentos</h5>
          <p class="text-muted">Recetas y presupuestos.</p>
          <a href="/documentos" class="btn btn-sub">Documentos</a>
        </div>
      </div>
    </div>
  </div>
  <!-- Zona fija de la mascota y el chat -->
  <div class="pet-pen" aria-hidden="true">
    <div id="pet" class="pet" role="button" aria-label="Abrir asistente">
      <div class="bubble">¡Hola! ¿Te puedo ayudar?</div>
      <div id="petAnim" class="pet-anim"></div>
    </div>

    <div id="petChat" class="pet-chat" aria-live="polite">
      <div class="pet-chat__hdr">
        <span class="pet-badge">🐶</span> Puca-Pet
      </div>
      <div id="chatBody" class="pet-chat__body">
        <div class="msg bot">¡Hola! Soy tu ayudante. ¿Que necesitas?</div>
      </div>
      <form id="chatForm" class="pet-chat__input">
        <input
          id="chatInput"
          type="text"
          placeholder="Escribe tu pregunta…"
          autocomplete="off"
        />
        <button type="submit">Enviar</button>
      </form>
    </div>
  </div>
  <div class="card shadow-sm mt-3">
    <div class="card-body">
      <h3 class="h5 mb-3">Productos</h3>

      <div class="d-flex gap-2 flex-wrap">
        <a class="btn" href="/galeria/accesorios">
          Accesorios
        </a>

        <a class="btn" href="/galeria/alimentos">
          Alimentos
        </a>

        <a class="btn btn--outline" href="/galeria/medicamentos">
          Medicamentos
        </a>
      </div>
    </div>
  </div>
</section>
` }) %>
