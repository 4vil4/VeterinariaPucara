<%- include('../layouts/layout', { title: 'Editar Mascota', body: `
<div class="card shadow-sm" style="max-width: 860px; margin: 0 auto">
  <div class="card-body">
    <h3 class="mb-3">Editar ${pet.name_pet || ('Mascota #' + pet.id)}</h3>

    <form action="/mascotas/${pet.id}/editar" method="post" enctype="multipart/form-data" class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Nombre</label>
        <input name="name_pet" class="form-control" value="${pet.name_pet || ''}">
      </div>

      <div class="col-md-3">
        <label class="form-label">Especie</label>
        <input name="especie" class="form-control" value="${pet.especie || ''}">
      </div>

      <div class="col-md-3">
        <label class="form-label">Raza</label>
        <input name="raza" class="form-control" value="${pet.raza || ''}">
      </div>

      <div class="col-md-3">
        <label class="form-label">Edad (años)</label>
        <input name="age" type="number" min="0" class="form-control" value="${pet.age ?? ''}">
      </div>

      <div class="col-md-3">
        <label class="form-label">Sexo</label>
        <select name="sexo" class="form-select">
          <option value="" ${!pet.sexo ? 'selected' : ''}>-</option>
          <option value="macho" ${pet.sexo==='macho'?'selected':''}>macho</option>
          <option value="hembra" ${pet.sexo==='hembra'?'selected':''}>hembra</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">¿Esterilizado?</label>
        <select name="esterilizado" class="form-select">
          <option value="" ${pet.esterilizado===null||pet.esterilizado===undefined?'selected':''}>-</option>
          <option value="1" ${pet.esterilizado===1?'selected':''}>SÍ</option>
          <option value="0" ${pet.esterilizado===0?'selected':''}>NO</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Fecha de nacimiento</label>
        <input name="fecha_nac" type="date" class="form-control" value="${pet.fecha_nac_iso || ''}">
      </div>

      <div class="col-md-3">
        <label class="form-label">Estado</label>
        <select name="estado" class="form-select">
          <option value="Activo" ${pet.estado==='Activo'?'selected':''}>Activo</option>
          <option value="Inactivo" ${pet.estado==='Inactivo'?'selected':''}>Inactivo</option>
        </select>
      </div>

      <div class="col-md-4">
        <label class="form-label">N° Historia Clínica</label>
        <input name="historia" class="form-control" value="${pet.historia || ''}">
      </div>

      <div class="col-12">
        <label class="form-label">Observaciones</label>
        <textarea name="observaciones" class="form-control" rows="3">${pet.observaciones || ''}</textarea>
      </div>

      <div class="col-md-8">
        <label class="form-label">Etiquetas (separadas por coma)</label>
        <input name="tags" class="form-control" value="${(pet.tags||[]).join(', ')}">
      </div>

      <div class="col-md-6">
        <label class="form-label">Foto (se guarda en la BD)</label>
        <input type="file" name="foto" accept="image/*" class="form-control">
        <div class="form-text">Si subes una nueva, reemplaza la actual.</div>
      </div>

      <div class="col-md-6">
        <label class="form-label">URL de foto (opcional)</label>
        <input name="foto_url" class="form-control" value="${pet.foto_url || ''}">
        <div class="form-text">Solo si prefieres enlazar una URL externa.</div>
      </div>

      <div class="col-12">
        <div class="d-flex gap-2">
          <a class="btn btn--outline" href="/mascotas/${pet.id}/ficha">Cancelar</a>
          <button class="btn btn-ficha" type="submit">Guardar cambios</button>
        </div>
      </div>

      <div class="col-12">
        <label class="form-label">Vista previa</label>
        <div id="previewBox" class="rounded overflow-hidden border"
            style="width:140px; aspect-ratio:3/4; display:flex; align-items:center; justify-content:center">
          ${
            pet.fotoBase64
              ? `<img src="data:image/jpeg;base64,${pet.fotoBase64}" style="width:100%;height:100%;object-fit:cover">`
              : (pet.foto_url
                  ? `<img src="${pet.foto_url}" style="width:100%;height:100%;object-fit:cover">`
                  : `<i class="fa-solid fa-paw" style="font-size:48px;opacity:.3"></i>`)
          }
        </div>
      </div>
    </form>
  </div>
</div>
<script>
(function(){
  var inp = document.querySelector('input[name="foto"]');
  var box = document.getElementById('previewBox');
  if (!inp || !box) return;
  inp.addEventListener('change', function(){
    if (this.files && this.files[0]) {
      var url = URL.createObjectURL(this.files[0]);
      box.innerHTML = '<img src="'+url+'" style="width:100%;height:100%;object-fit:cover">';
    } else {
      box.innerHTML = '<i class="fa-solid fa-paw" style="font-size:48px;opacity:.3"></i>';
    }
  });
})();
</script>
` }) %>
