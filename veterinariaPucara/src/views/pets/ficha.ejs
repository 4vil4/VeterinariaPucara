<%- include('../layouts/layout', { title: 'Ficha', body: `
<div class="card shadow-sm" style="max-width: 760px; margin: 0 auto">
  <div class="card-body">
    <div class="d-flex gap-3">
      <div style="width: 140px; min-width: 140px">
        <div
          class="rounded overflow-hidden border"
          style="
            aspect-ratio: 3/4;
            background: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >
          ${ pet.fotoDataUrl ? `<img
            src="${pet.fotoDataUrl}"
            alt="Foto de ${pet.name_pet || ''}"
            style="width: 100%; height: 100%; object-fit: cover"
          />` : (pet.foto_url ? `<img
            src="${pet.foto_url}"
            alt="Foto de ${pet.name_pet || ''}"
            style="width: 100%; height: 100%; object-fit: cover"
          />` : `<i
            class="fa-solid fa-paw"
            style="font-size: 48px; opacity: 0.3"
          ></i
          >`) }
        </div>
      </div>

      <div class="flex-grow-1">
        <h3
          class="mb-2"
          style="
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: space-between;
          "
        >
          <span style="display: flex; align-items: center; gap: 8px">
            <span>${pet.name_pet || ('Mascota #' + pet.id)}</span>
            <span class="status-dot" title="${pet.estado || 'Activo'}"></span>
          </span>
          <a class="btn btn-ficha" href="/mascotas/${pet.id}/editar">Editar</a>
        </h3>

        <div class="row g-2">
          <div class="col-md-6 small text-muted">N° Historia Clínica</div>
          <div class="col-md-6"><strong>${pet.historia || '-'}</strong></div>

          <div class="col-md-6 small text-muted">Especie</div>
          <div class="col-md-6">${pet.especie || '-'}</div>

          <div class="col-md-6 small text-muted">Raza</div>
          <div class="col-md-6">${pet.raza || '-'}</div>

          <div class="col-md-6 small text-muted">Sexo</div>
          <div class="col-md-6">${pet.sexo || '-'}</div>

          <div class="col-md-6 small text-muted">¿Esterilizado?</div>
          <div class="col-md-6">
            ${ (pet.esterilizado === 1 || pet.esterilizado === true) ? 'SÍ' :
            (pet.esterilizado === 0 ? 'NO' : '-') }
          </div>

          <div class="col-md-6 small text-muted">Fecha de nacimiento</div>
          <div class="col-md-6">${pet.fecha_nac_fmt || '-'}</div>

          <div class="col-md-6 small text-muted">Edad</div>
          <div class="col-md-6">
            ${pet.edad_human || (pet.age ? (pet.age + ' años') : '-')}
          </div>

          <div class="col-md-6 small text-muted">Propietario</div>
          <div class="col-md-6">
            <a href="/owners/${owner.id}/pets">${owner.name}</a>
            ${ owner.fono ? `&nbsp;<a
              class="btn btn-wsp"
              href="/citas/whatsapp?to=${encodeURIComponent(owner.fono)}&name=${encodeURIComponent(owner.name)}"
              title="WhatsApp"
              style="padding: 2px 8px"
              ><i class="fab fa-whatsapp"></i></a
            >` : `` }
          </div>

          <div class="col-md-6 small text-muted">Etiquetas</div>
          <div class="col-md-6">
            ${ (pet.tags && pet.tags.length) ? pet.tags.join(', ') : '-' }
          </div>
          
          <div class="col-md-6 small text-muted">Observaciones</div>
          <div class="col-md-6">
            ${pet.observaciones ? pet.observaciones : '-'}
          </div>
        </div>

        ${ (pet.tags && pet.tags.map(t =>
        String(t).toLowerCase()).includes('agresivo')) ? `
        <div class="alert alert-warning mt-3" role="alert">
          ${(pet.especie || 'PERRO').toUpperCase()} AGRESIVO
        </div>
        ` : `` }
      </div>
    </div>
  </div>
</div>
` }) %>
